# Primary path for `speak` — Groq Orpheus (troy)
# https://console.groq.com
#
# Global CLI (uv tool / pipx) looks for the key in this order:
#   1. process env:  export GROQ_API_KEY=...
#   2. SPEAKER_ENV=path/to/file
#   3. ./.env  (current working directory)
#   4. ~/.config/speaker/.env   ← recommended for global `speak`
#   5. ~/.speaker.env
#
# Example for global install:
#   mkdir -p ~/.config/speaker
#   cp .env.example ~/.config/speaker/.env
#   # then edit GROQ_API_KEY in that file
GROQ_API_KEY=gsk_your_key_here

# Backend: auto (default) | groq | local | say
#   auto  — Groq → local Orpheus → macOS say
#   groq  — cloud only (needs GROQ_API_KEY)
#   local — Metal Orpheus only (EN/DE; needs llama-cpp-python)
#   say   — macOS say only
# SPEAK_ENGINE=auto

# Optional — tempo (0.5–3.0, default 1.0). >1 = faster, pitch preserved.
# SPEAK_SPEED=1.25

# Optional — higher HF download limits when fetching local GGUF models
# HF_TOKEN=hf_your_token_here
